<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
  <% if (typeof hasSiteCss !== 'undefined' && hasSiteCss) { %>
  <link rel="stylesheet" href="/css/site.css">
  <% } %>
<!-- Fallback refresh every 5 minutes (300 seconds) -->
<meta http-equiv="refresh" content="300">

<!-- Add this before the closing </head> tag -->
<script>
  // Set up periodic refresh (every 5 minutes)
  setTimeout(function() {
    // Reload the page without using cache
    window.location.reload(true);
  }, 5 * 60 * 1000);
</script>


<style>
  <% if (data && data.settings && data.settings.colors) { %>
    body {
      color: <%= data.settings.colors.directoryText %>;
      background-color: <%= data.settings.colors.directoryBackground %>;
    }
    
    header {
      background-color: <%= data.settings.colors.headerBackground %>;
      color: <%= data.settings.colors.headerText %>;
    }
    
    h2 {
      border-bottom-color: <%= data.settings.colors.headerBackground %>;
    }
    
    .tenant {
      background-color: <%= data.settings.colors.tenantBackground %>;
    }
    
    .info-section {
      background-color: <%= data.settings.colors.infoBackground %>;
      color: <%= data.settings.colors.infoText %>;
    }
    
    .info-section h3 {
      color: <%= data.settings.colors.headerBackground %>;
    }
    
    footer {
      background-color: <%= data.settings.colors.footerBackground %>;
      color: <%= data.settings.colors.footerText %>;
    }
  <% } %>
</style>


</head>
<body>
  <div class="container">
    <header>
<div class="building-image">
  <% if (data && data.settings && data.settings.hasBuildingImage) { %>
    <img src="/images/building-image.jpg?v=<%= new Date().getTime() %>" alt="Building" class="building-img">
  <% } else { %>
    <div class="placeholder">Building Image</div>
  <% } %>
</div>


      <h1><%= message %></h1>
    </header>
    
    <main class="directory">
      <h2>Directory</h2>
      <ul class="tenant-list">
        <% if (tenants && tenants.length > 0) { %>
          <% tenants.forEach(tenant => { %>
            <li class="tenant">
              <span class="suite"><%= tenant.suite %></span>
              <span class="name"><%= tenant.name %></span>
            </li>
          <% }); %>
        <% } else { %>
          <li class="tenant empty">No tenants listed</li>
        <% } %>
      </ul>
    </main>
    
    <% if (showInfo && infoSection) { %>
      <div class="info-section">
        <h3><%= infoSection.title %></h3>
        <div class="info-content">
          <%= infoSection.content %>
        </div>
      </div>
    <% } %>
    
<footer>
  <div class="widget">
    <div class="clock-container">
      <div id="live-clock"></div>
      <div id="current-date"></div>
    </div>

