<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Building Directory - Admin Panel</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="admin-container">
    <header class="admin-header">
      <h1>Building Directory Admin</h1>
      <div class="admin-nav">
        <a href="/admin" class="active">Dashboard</a>
        <a href="/admin/logout" class="logout">Logout</a>
      </div>
    </header>
    
    <% if (message) { %>
      <div class="notification">
        <%= message.replace(/\+/g, ' ') %>
      </div>
    <% } %>
    
    <div class="admin-content">
      <div class="admin-section">
        <h2>General Settings</h2>
        <form action="/admin/settings" method="POST">
          <div class="form-group">
            <label for="buildingName">Building Name</label>
            <input type="text" id="buildingName" name="buildingName" value="<%= data.settings.buildingName %>" required>
          </div>
          
          <div class="form-group">
            <label for="welcomeMessage">Welcome Message</label>
            <input type="text" id="welcomeMessage" name="welcomeMessage" value="<%= data.settings.welcomeMessage %>" required>
          </div>
          
          <div class="form-check">
            <input type="checkbox" id="showInfoSection" name="showInfoSection" <%= data.settings.showInfoSection ? 'checked' : '' %>>
            <label for="showInfoSection">Show Information Section</label>
          </div>
          
          <button type="submit" class="btn btn-primary">Save Settings</button>
        </form>
      </div>

<div class="admin-section">
        <h2>Building Image</h2>
        <div class="image-preview">
          <% if (data.settings.hasBuildingImage) { %>
            <img src="/images/building-image.jpg?v=<%= new Date().getTime() %>" alt="Building Image" class="building-preview">
          <% } else { %>
            <div class="placeholder">No image uploaded</div>
          <% } %>
        </div>
        
        <form action="/admin/upload-image" method="POST" enctype="multipart/form-data">
          <div class="form-group">
            <label for="buildingImage">Upload New Image</label>
            <input type="file" id="buildingImage" name="buildingImage" accept="image/*" required>
<small>
  Maximum file size: 5MB. Images will be automatically resized to fit. 
  For best results, use landscape orientation images with a minimum width of 800px.
</small>
          </div>
          <button type="submit" class="btn btn-primary">Upload Image</button>
        </form>
      </div>

<div class="admin-section">
  <h2>Color Settings</h2>
  <form action="/admin/colors" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label for="headerBackground">Header Background</label>
        <input type="color" id="headerBackground" name="headerBackground" value="<%= data.settings.colors ? data.settings.colors.headerBackground : '#1a5276' %>">
      </div>
      
      <div class="form-group">
        <label for="headerText">Header Text</label>
        <input type="color" id="headerText" name="headerText" value="<%= data.settings.colors ? data.settings.colors.headerText : '#ffffff' %>">
      </div>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <label for="directoryBackground">Directory Background</label>
        <input type="color" id="directoryBackground" name="directoryBackground" value="<%= data.settings.colors ? data.settings.colors.directoryBackground : '#f5f5f5' %>">
      </div>
      
      <div class="form-group">
        <label for="directoryText">Directory Text</label>
        <input type="color" id="directoryText" name="directoryText" value="<%= data.settings.colors ? data.settings.colors.directoryText : '#333333' %>">
      </div>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <label for="tenantBackground">Tenant Background</label>
        <input type="color" id="tenantBackground" name="tenantBackground" value="<%= data.settings.colors ? data.settings.colors.tenantBackground : '#ffffff' %>">
      </div>
      
      <div class="form-group">
        <label for="infoBackground">Info Section Background</label>
        <input type="color" id="infoBackground" name="infoBackground" value="<%= data.settings.colors ? data.settings.colors.infoBackground : '#f0f7fc' %>">
      </div>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <label for="infoText">Info Section Text</label>
        <input type="color" id="infoText" name="infoText" value="<%= data.settings.colors ? data.settings.colors.infoText : '#333333' %>">
      </div>
      
      <div class="form-group">
        <label for="footerBackground">Footer Background</label>
        <input type="color" id="footerBackground" name="footerBackground" value="<%= data.settings.colors ? data.settings.colors.footerBackground : '#1a5276' %>">
      </div>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <label for="footerText">Footer Text</label>
        <input type="color" id="footerText" name="footerText" value="<%= data.settings.colors ? data.settings.colors.footerText : '#ffffff' %>">
      </div>
    </div>
    
    <button type="submit" class="btn btn-primary">Save Color Settings</button>
  </form>
</div>
      
      <div class="admin-section">
        <h2>Directory Listings</h2>
        <table class="tenant-table">
          <thead>
            <tr>
              <th>Suite</th>
              <th>Tenant Name</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% data.tenants.forEach(tenant => { %>
              <tr>
                <td><%= tenant.suite %></td>
                <td><%= tenant.name %></td>
                <td class="actions">
                  <button class="btn btn-edit" onclick="editTenant('<%= tenant.id %>', '<%= tenant.suite %>', '<%= tenant.name %>')">Edit</button>
                  <form action="/admin/tenant/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this tenant?')">
                    <input type="hidden" name="id" value="<%= tenant.id %>">
                    <button type="submit" class="btn btn-delete">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        
        <div class="tenant-form">
          <h3 id="formTitle">Add New Tenant</h3>
          <form id="tenantForm" action="/admin/tenant/add" method="POST">
            <input type="hidden" id="tenantId" name="id" value="">
            
            <div class="form-group">
              <label for="suite">Suite Number</label>
              <input type="text" id="suite" name="suite" required>
            </div>
            
            <div class="form-group">
              <label for="name">Tenant Name</label>
              <input type="text" id="name" name="name" required>
            </div>
            
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Save Tenant</button>
              <button type="button" class="btn btn-cancel" onclick="resetTenantForm()" style="display:none;">Cancel</button>
            </div>
          </form>
        </div>
      </div>
      
      <div class="admin-section">
        <h2>Information Section</h2>
        <form action="/admin/info" method="POST">
          <div class="form-group">
            <label for="infoTitle">Section Title</label>
            <input type="text" id="infoTitle" name="infoTitle" value="<%= data.infoSection.title %>">
          </div>
          
          <div class="form-group">
            <label for="infoContent">Content</label>
            <textarea id="infoContent" name="infoContent" rows="5"><%= data.infoSection.content %></textarea>
          </div>
          
          <button type="submit" class="btn btn-primary">Save Info Section</button>
        </form>
      </div>
      
      <div class="admin-section">
        <h2>Change Password</h2>
        <form action="/admin/change-password" method="POST">
          <div class="form-group">
            <label for="currentPassword">Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword" required>
          </div>
          
          <div class="form-group">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="newPassword" required>
          </div>
          
          <div class="form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" required>
          </div>
          
          <button type="submit" class="btn btn-primary">Change Password</button>
        </form>
      </div>
    </div>
  </div>
  
  <script>
    function editTenant(id, suite, name) {
      document.getElementById('formTitle').textContent = 'Edit Tenant';
      document.getElementById('tenantForm').action = '/admin/tenant/edit';
      document.getElementById('tenantId').value = id;
      document.getElementById('suite').value = suite;
      document.getElementById('name').value = name;
      document.querySelector('.btn-cancel').style.display = 'inline-block';
    }
    
    function resetTenantForm() {
      document.getElementById('formTitle').textContent = 'Add New Tenant';
      document.getElementById('tenantForm').action = '/admin/tenant/add';
      document.getElementById('tenantId').value = '';
      document.getElementById('suite').value = '';
      document.getElementById('name').value = '';
      document.querySelector('.btn-cancel').style.display = 'none';
    }
  </script>
</body>
</html>
